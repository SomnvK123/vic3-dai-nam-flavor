entity = {
	name = "ecchi_spad_russia_2_entity"
	pdxmesh = "ecchi_spad_russia_2_mesh"
	
    default_state = "moving"
	locator = { name = "loc_light" position = { 0 0.87 -0.6 } rotation = { 0 0 0 }}

    state = {
        name = "moving"
        animation = "moving_animation"
        looping = yes
        next_state = "moving"

		start_event = { time = 0 node = "loc_light" particle = "infrastructure/zeppelin_01_lights" trigger_once = yes}

        start_event = { sound  = { soundeffect = "event:/SFX/Animation/vehicles/naval/support_vessel/carrier/wpn_carrier_plane_carrier_recon" } keep_sound = yes }
    }
    scale = 2.0
}
