pdxmesh = {
	name = "albatros_austria_2_mesh"
	file = "albatros.mesh"


	lod_percentages = {
		lod = { index = 1 percent = 6.0 }
		lod = { index = 2 percent = 2.0 }
	}
	animation = { id = "moving_animation" type = "generic_aerial_bleriotxi_01_moving.anim" }
	animation = { id = "carrier_idle_animation" type = "generic_aerial_bleriotxi_01_carrier_idle.anim" }
	animation = { id = "carrier_recon_animation" type = "generic_aerial_bleriotxi_01_carrier_recon.anim" }


	
	meshsettings = {
		name = "LOD_0_albatrosShape"
		index = 0
		texture_diffuse = "albatros_austria_2_diffuse.dds"
		texture_normal = "albatros_normal.dds"
		texture_specular = "albatros_properties.dds"
		texture = { file = "albatros_tint.dds" index = 5 }
		shader = "standard"
		additional_shader_defines = { "TINT_COLOR" }	
		shader_file = "gfx/FX/pdxmesh.shader"
	}
