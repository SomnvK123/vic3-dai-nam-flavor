		index = 0
		texture_diffuse = "albatros_austria_2_diffuse.dds"
		texture_normal = "albatros_normal.dds"
		texture_specular = "albatros_properties.dds"
		texture = { file = "albatros_tint.dds" index = 5 }
		shader = "standard"
		additional_shader_defines = { "TINT_COLOR" }		
		shader_file = "gfx/FX/pdxmesh.shader"
	}
	meshsettings = {
		name = "LOD_1_propShape"
		index = 0
		texture_diffuse = "generic_aerial_bleriotxi_01_diffuse.dds"
		texture_normal = "generic_aerial_bleriotxi_01_normal.dds"
		texture_specular = "generic_aerial_bleriotxi_01_properties.dds"
		shader = "standard_alpha_blend"
		shader_file = "gfx/FX/pdxmesh.shader"
	}	
		meshsettings = {
