### ============================================================
### TYPES
### ============================================================

types green_magical_girl_journal_entry_widget_types
{
	type gmg_country_visit_entry = flowcontainer {
	direction = vertical

	divider_clean = {}

	widget = {
		parentanchor = hcenter
		size = { 500 105 }
		maximumsize = { 500 105 }
		datacontext = "[Scope.GetCountry]"
		visible = "[Scope.GetCountry.IsValid]"

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding

			hbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				margin_left = 30

				### ====================================================
				### 左侧：领导人头像
				### ====================================================
				vbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = growing

					widget = {
						size = { 90 90 }

						character_portrait_medium = {
							datacontext = "[Country.GetRuler]"
							using = tooltip_es
							blockoverride "show_hat" {}
							parentanchor = vcenter
							blockoverride "highlight" {}
							blockoverride "rank_icon" {}
						}

						### 国家旗帜
						icon = {
							parentanchor = bottom|left
							size = { 35 35 }
							texture = "[Country.GetFlag]"
						}

						### 领导人意识形态
						icon = {
							datacontext = "[Country.GetRuler.GetIdeology]"
							texture = "[Ideology.GetTexture]"
							tooltipwidget = {
								FancyTooltip_Ideology = {}
							}
							size = { 35 35 }
							parentanchor = bottom|right
						}
					}
				}

				### ====================================================
				### 右侧：顶部国家栏 + 底部信息栏
				### ====================================================
				vbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					margin_left = 5

					### ====================================================
					### 顶部：保留原版国家名/国旗UI
					### ====================================================
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = growing

						background = {
							using = dark_area

							modify_texture = {
								texture = "gfx/interface/masks/fade_horizontal_center.dds"
								spriteType = Corneredstretched
								spriteborder = { 0 0 }
								blend_mode = alphamultiply
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding

							### 国家名
							textbox = {
								layoutpolicy_horizontal = expanding
								size = { 0 30 }
								text = "[Country.GetName]"
								default_format = "#v"
								align = left
								using = regular_font
								elide = right
							}

							### 右侧保留一个简短标题
							textbox = {
								layoutpolicy_horizontal = growing
								size = { 0 30 }
								text = "gmg_visit_count_inline"
								default_format = "#v"
								align = right
								using = regular_font
								elide = right
							}
						}
					}

					### ====================================================
					### 底部：四项信息
					### ====================================================
					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin_top = 5

						### 1. 领导人名字
						vbox = {
							layoutpolicy_horizontal = growing

							icon = {
								size = { 45 45 }
								texture = "gfx/interface/icons/timed_modifier_icons/modifier_statue_positive.dds"
							}

							textbox = {
								layoutpolicy_horizontal = expanding
								size = { 110 30 }
								text = "[Country.GetRuler.GetFullNameNoFormatting]"
								align = center|nobaseline
								using = fontsize_medium
								elide = right
							}
						}

						### 2. 首都
						vbox = {
							layoutpolicy_horizontal = growing

							icon = {
								size = { 45 45 }
								texture = "gfx/interface/icons/generic_icons/prestige.dds"
							}

							textbox = {
								layoutpolicy_horizontal = expanding
								size = { 90 30 }
								text = "[Country.GetCapital.GetName]"
								align = center|nobaseline
								using = fontsize_medium
								elide = right
							}
						}

						### 3. 旅游次数
						vbox = {
							layoutpolicy_horizontal = growing

							icon = {
								size = { 45 45 }
								texture = "gfx/interface/icons/event_icons/event_map.dds"
							}

							textbox = {
								layoutpolicy_horizontal = expanding
								size = { 60 30 }
								text = "[Country.MakeScope.ScriptValue('gmg_visit_count_by_green_magical_girl')|v0]"
								align = center|nobaseline
								using = fontsize_medium
								elide = right
							}
						}

						### 4. 国家等级
vbox = {
	layoutpolicy_horizontal = growing

	rank_badge = {
		size = { 45 45 }

		blockoverride "font_size_under_100_rank" {
			using = fontsize_medium
		}
	}

	textbox = {
		layoutpolicy_horizontal = expanding
		size = { 100 30 }
		text = "[Country.GetRank]"
		align = center|nobaseline
		using = fontsize_medium
		elide = right
	}
}
					}
				}
			}
		}
	}
}


	type gmg_green_magical_girl_header_portrait = widget {
		### 纸片人版本
		### 不使用 Character.GetAnimatedPortrait，只显示 DDS 纸片人。

		widget = {
			size = { 100% 100% }

			background = {
				texture = "gfx/interface/character_panel/backgrounds/char_role_ruler_japan_post_meiji.dds"
				fittype = centercrop
			}
		}

		### 底部暗色渐变
		icon = {
			using = dark_area
			parentanchor = bottom|hcenter
			size = { 100% 52% }
			alpha = 0.60
			position = { 0 2 }

			modify_texture = {
				texture = "gfx/interface/masks/fade_vertical_top.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}

		character_portrait_base_no_mask = {
			datacontext = "[JournalEntry.GetCountry.MakeScope.Var('gmg_green_magical_girl_var')]"
			ignore_in_debug_draw = yes
			size = { 217 261 } #+37 +21 (space for frame)

			block "character_layout" {
				position = { 150 -150 }
				size = { 250 500 }
			}

			blockoverride "portrait_size" {
				block "character_portrait_size" {
					size = { 400 400 }
				}
			}
			blockoverride "portrait_texture" {
				portrait_texture = "[Scope.GetCharacter.GetAnimatedPortrait('ruler_environment', 'camera_body', 'idle', GetPortraitRenderSize(PdxGuiWidget.Self))]"
			}

			blockoverride "portrait_icons" {}

			blockoverride "tooltip" {
				tooltipwidget = {
					FancyTooltip_Character = {
						datacontext = "[Scope.AccessCharacter]"
					}
				}
			}
		}

		### 右侧信息暗板
		### 和右侧 flowcontainer 一起左移，避免被地图边缘吃掉。
		widget = {
			parentanchor = right|vcenter
			position = { -18 0 }
			size = { 270 305 }

			background = {
				using = dark_area
				alpha = 0.45

				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
					blend_mode = alphamultiply
				}
			}
		}

		### 前景边框
		widget = {
			size = { 100% 100% }

			background = {
				texture = "gfx/interface/character_panel/char_bg_frame.dds"
				margin_left = 18
				margin_right = 10
				margin_bottom = 10
				spriteType = Corneredtiled

				spriteborder_left = 200
				spriteborder_right = 60
				spriteborder_top = 170
				spriteborder_bottom = 180

				texture_density = 2
			}
		}
	}
}


### ============================================================
### WIDGETS
### ============================================================

flowcontainer = {
	name = "widget_je_green_magical_girl_header"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical

		gmg_green_magical_girl_header_portrait = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			### 比原版稍大，但不过度放大。
			minimumsize = { 600 350 }

			### ====================================================
			### 右侧统一信息栏
			###
			### 重要：
			### 这里的 datacontext 是探险家角色本体。
			### 该角色需要由脚本层用 has_variable = dsk_go_travel
			### 找到并保存到 gmg_green_magical_girl_var。
			### ====================================================
			flowcontainer = {
				parentanchor = right|top
				position = { -35 8 }
				direction = vertical
				spacing = 5

				datacontext = "[JournalEntry.GetCountry.MakeScope.Var('gmg_green_magical_girl_var').GetCharacter]"

				background = {
					using = dark_area
					alpha = 0.75

					modify_texture = {
						texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
						blend_mode = alphamultiply
					}
				}

				### ====================================================
				### 利益集团
				###
				### 注意：
				### 这里不要把整个 ruler_stats_entry 的 datacontext
				### 改成 Character.GetInterestGroup。
				### 当前上下文必须保持为 Character。
				### ====================================================
				ruler_stats_entry = {
					tooltipwidget = {
						FancyTooltip_IG = {
							datacontext = "[Character.GetInterestGroup]"
						}
					}

					blockoverride "ruler_icon" {
						character_ig_button = {
							datacontext = "[Character.GetInterestGroup]"
							size = { 35 35 }

							blockoverride "in_government_icon" {}
						}
					}

					blockoverride "label" {
						text = "INTEREST_GROUP"
					}

					blockoverride "text" {
						raw_text = "#v [Character.GetInterestGroup.GetNameNoFormatting]#!"
					}
				}

				### ====================================================
				### 意识形态
				###
				### 同样保持主上下文为 Character。
				### 只有图标和 tooltip 内部临时切到 Ideology。
				### ====================================================
				ruler_stats_entry = {
					tooltipwidget = {
						FancyTooltip_Ideology = {
							datacontext = "[Character.GetIdeology]"
						}
					}

					blockoverride "ruler_icon" {
						widget = {
							size = { 35 35 }

							icon = {
								datacontext = "[Character.GetIdeology]"
								size = { 100% 100% }
								texture = "[Ideology.GetTexture]"
							}
						}
					}

					blockoverride "label" {
						text = "IDEOLOGY_CONCEPT"
					}

					blockoverride "text" {
						raw_text = "#v [Character.GetIdeology.GetNameNoFormatting]#!"
					}
				}

				### ====================================================
				### 声望 / 人气
				### ====================================================
				ruler_stats_entry = {
					tooltip = "PROMINENCE_BREAKDOWN"

					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/prominence.dds"
					}

					blockoverride "label" {
						text = "PROMINENCE"
					}

					blockoverride "text" {
						text = "CHARACTER_PROMINENCE"
					}
				}

				### ====================================================
				### 总旅行次数
				###
				### 这里需要国家上下文，所以单独切到 JournalEntry.GetCountry。
				### ====================================================
				ruler_stats_entry = {
					datacontext = "[JournalEntry.GetCountry]"

					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/prominence.dds"
					}

					blockoverride "label" {
						text = "gmg_total_tours_label"
					}

					blockoverride "text" {
						text = "[Country.MakeScope.ScriptValue('gmg_total_tours')|v0]"
					}
				}

				### ====================================================
				### 上次旅行国家
				### ====================================================
				ruler_stats_entry = {
	datacontext = "[JournalEntry.GetCountry.MakeScope.Var('gmg_last_tour_country').GetCountry]"

	blockoverride "icon_texture" {
		texture = "gfx/interface/icons/event_icons/event_trade.dds"
	}

	blockoverride "label" {
		text = "gmg_last_tour_country_label"
	}

	blockoverride "text" {
		text = "[Country.GetName]"
	}
}

				### ====================================================
### 当前状态：准备出发
### ====================================================
ruler_stats_entry = {
	datacontext = "[JournalEntry.GetCountry]"
	visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('gmg_tour_cooldown').IsSet)]"

	blockoverride "icon_texture" {
		texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
	}

	blockoverride "label" {
		text = "gmg_status_label"
	}

	blockoverride "text" {
		text = "je_green_magical_girl_world_tour_status_ready"
	}
}

### ====================================================
### 当前状态：旅游中
### ====================================================
ruler_stats_entry = {
	datacontext = "[JournalEntry.GetCountry]"
	visible = "[JournalEntry.GetCountry.MakeScope.Var('gmg_tour_cooldown').IsSet]"

	blockoverride "icon_texture" {
		texture = "gfx/interface/icons/event_icons/event_map.dds"
	}

	blockoverride "label" {
		text = "gmg_status_label"
	}

	blockoverride "text" {
		text = "je_green_magical_girl_world_tour_status_travelling"
	}
}
			}
		}
	}
}


flowcontainer = {
	name = "widget_je_green_magical_girl_travel_log"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		margin_left = 70
		margin_right = 12

		section_header_button = {
			blockoverride "layout" {
				size = { 600 38 }
			}

			blockoverride "left_text" {
				text = "gmg_travel_log_header"
			}

			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('green_magical_girl_travel_log_toggle')]"
			}

			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('green_magical_girl_travel_log_toggle'))]"
			}

			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('green_magical_girl_travel_log_toggle')]"
			}
		}

		### 空列表提示
		### 暂时隐藏，避免部分版本 HasList / 空 list 报错。
		textbox = {
			visible = no
			layoutpolicy_horizontal = expanding
			size = { 600 60 }
			text = "gmg_no_visited_country_yet"
			align = center
			using = fontsize_medium
		}

		fixedgridbox = {
			visible = "[GetVariableSystem.Exists('green_magical_girl_travel_log_toggle')]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('gmg_visited_countries')]"
			addcolumn = 600
			addrow = 110

			background = {
				texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
				color = { 0.20 0.40 0.22 1 }
				alpha = 0.4

				modify_texture = {
					using = texture_velvet
				}
			}

			item = {
				gmg_country_visit_entry = {}
			}
		}

		expand = {}
	}
}